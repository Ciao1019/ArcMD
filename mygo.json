      "role": "Editor"
    }
  ],
  "linux": { "webview": false },
  "updates": {
    "publicKey": "5WSm8Z4W2nF//KbuHmHZjP1uR8RC7vvS/xApNVO5nWc=",
    "github": "Ciao1019/ArcMD"
  }
}
