{
  "name": "ArcMD",
  "slug": "arcmd",
  "identifier": "com.cizai.arcmd",
  "version": "0.5.1",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 ArcMD contributors",
  "icon": "resources/icon.png",
  "main": "./cmd/arcmd",
  "out": "dist",
  "resources": ["LICENSE", "third_party"],
  "resourcesExclude": ["icon.icns", "icon.png"],
  "fileAssociations": [
    {
      "ext": ["md", "markdown", "mdx"],
      "name": "Markdown Document",
      "mimeType": "text/markdown",
      "role": "Editor"
    },
    {
      "ext": ["arcmd"],
      "name": "ArcMD Document",
      "mimeType": "application/x-arcmd",
      "role": "Editor"
    },
    {
      "ext": ["excalidraw"],
      "name": "Excalidraw Whiteboard",
      "mimeType": "application/vnd.excalidraw+json",
      "role": "Editor"
    },
    {
      "ext": ["pdf"],
      "name": "PDF Document",
      "mimeType": "application/pdf",
      "role": "Viewer"
    },
    {
      "ext": ["epub"],
      "name": "EPUB Book",
      "mimeType": "application/epub+zip",
      "role": "Viewer"
    },
    {
      "ext": ["html", "htm"],
      "name": "HTML Document",
      "mimeType": "text/html",
      "role": "Viewer"
    },
    {
      "ext": ["mdz"],
      "name": "MDZip Document",
      "mimeType": "application/vnd.mdzip",
      "role": "Viewer"
    }
  ],
  "macos": {
    "icon": "resources/icon.icns"
  },
  "linux": {
    "webview": false,
    "comment": "Native Markdown and rich-text editor",
    "categories": ["Office"],
    "command": "arcmd",
    "depends": {
      "arch": ["hicolor-icon-theme", "poppler-glib"]
    }
  },
  "updates": {
    "publicKey": "5WSm8Z4W2nF//KbuHmHZjP1uR8RC7vvS/xApNVO5nWc=",
    "github": "Ciao1019/ArcMD"
  }
}
