{
  "name": "ArcMD",
  "slug": "arcmd",
  "identifier": "com.cizai.arcmd",
  "version": "0.0.1",
  "icon": "resources/icon.png",
  "main": "./cmd/arcmd",
  "out": "dist",
  "resources": ["LICENSE", "third_party"],
  "fileAssociations": [
    {
      "ext": ["arcmd"],
      "name": "ArcMD Document",
