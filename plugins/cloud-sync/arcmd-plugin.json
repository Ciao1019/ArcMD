{
  "id": "dev.arcmd.cloud-sync",
  "name": "云端同步",
  "version": "0.1.0",
  "description": "通过 S3（兼容 R2 / OSS / COS / MinIO）或 WebDAV（坚果云 / Nextcloud / Alist）双向增量同步空间文档与附件。",
  "author": "ArcMD",
  "license": "MIT",
  "icon": "cloud",
  "engine": "0.2.3",
  "runtime": "wasm",
  "main": "plugin.wasm",
  "permissions": [
    "space:read",
    "space:write",
    "network",
    "secrets",
    "ui:panel"
  ],
  "contributes": {
    "commands": [
      {
        "id": "sync-now",
        "title": "云端同步：立即同步",
        "primary": true,
        "inSettings": true
      },
      {
        "id": "test-connection",
        "title": "云端同步：测试连接",
        "inSettings": true
      },
      {
        "id": "sync-status",
        "title": "云端同步：查看同步记录"
      }
    ],
    "panels": [
      {
        "id": "status",
        "title": "云端同步",
        "icon": "☁"
      }
    ],
    "settings": [
      {
        "id": "provider",
        "title": "同步方式",
        "group": "连接设置",
        "type": "segmented",
        "default": "s3",
        "options": [
          { "value": "s3", "label": "S3 对象存储" },
          { "value": "webdav", "label": "WebDAV" }
        ]
      },
      {
        "id": "s3Endpoint",
        "title": "Endpoint",
        "description": "S3 兼容服务地址",
        "group": "连接设置",
        "type": "string",
        "placeholder": "https://...r2.cloudflarestorage.com",
        "when": { "field": "provider", "equals": "s3" },
        "presets": [
          {
            "name": "Cloudflare R2",
            "values": {
              "s3Endpoint": "https://<accountid>.r2.cloudflarestorage.com",
              "s3Region": "auto",
              "s3PathStyle": false
            }
          },
          {
            "name": "AWS S3",
            "values": {
              "s3Endpoint": "https://s3.us-east-1.amazonaws.com",
              "s3Region": "us-east-1",
              "s3PathStyle": false
            }
          },
          {
            "name": "阿里云 OSS",
            "values": {
              "s3Endpoint": "https://oss-cn-hangzhou.aliyuncs.com",
              "s3Region": "cn-hangzhou",
              "s3PathStyle": false
            }
          },
          {
            "name": "腾讯云 COS",
            "values": {
              "s3Endpoint": "https://cos.ap-guangzhou.myqcloud.com",
              "s3Region": "ap-guangzhou",
              "s3PathStyle": false
            }
          },
          {
            "name": "Backblaze B2",
            "values": {
              "s3Endpoint": "https://s3.us-west-004.backblazeb2.com",
              "s3Region": "us-west-004",
              "s3PathStyle": false
            }
          },
          {
            "name": "MinIO 本机",
            "values": {
              "s3Endpoint": "http://127.0.0.1:9000",
              "s3Region": "us-east-1",
              "s3PathStyle": true
            }
          }
        ]
      },
      {
        "id": "s3Region",
        "title": "Region",
        "group": "连接设置",
        "type": "string",
        "default": "auto",
        "placeholder": "auto / us-east-1",
        "when": { "field": "provider", "equals": "s3" }
      },
      {
        "id": "s3Bucket",
        "title": "Bucket",
        "group": "连接设置",
        "type": "string",
        "placeholder": "my-notes",
        "when": { "field": "provider", "equals": "s3" }
      },
      {
        "id": "s3AccessKey",
        "title": "Access Key ID",
        "group": "连接设置",
        "type": "string",
        "placeholder": "Access Key ID",
        "when": { "field": "provider", "equals": "s3" }
      },
      {
        "id": "s3SecretKey",
        "title": "Secret Access Key",
        "description": "保存在本机凭据目录，不进空间文件夹",
        "group": "连接设置",
        "type": "secret",
        "placeholder": "Secret Access Key",
        "when": { "field": "provider", "equals": "s3" }
      },
      {
        "id": "s3Prefix",
        "title": "远端目录前缀",
        "group": "连接设置",
        "type": "string",
        "default": "ArcMD",
        "placeholder": "ArcMD",
        "when": { "field": "provider", "equals": "s3" }
      },
      {
        "id": "s3PathStyle",
        "title": "使用 Path-Style 路径模式",
        "description": "MinIO 等自建服务通常需要开启；IP 或本机地址自动启用。",
        "group": "连接设置",
        "type": "bool",
        "default": false,
        "when": { "field": "provider", "equals": "s3" }
      },
      {
        "id": "webdavURL",
        "title": "服务器地址",
        "description": "WebDAV 服务根地址",
        "group": "连接设置",
        "type": "string",
        "placeholder": "https://dav.jianguoyun.com/dav/",
        "when": { "field": "provider", "equals": "webdav" },
        "presets": [
          {
            "name": "坚果云",
            "values": {
              "webdavURL": "https://dav.jianguoyun.com/dav/"
            }
          },
          {
            "name": "Nextcloud",
            "values": {
              "webdavURL": "https://cloud.example.com/remote.php/dav/files/<用户名>/"
            }
          },
          {
            "name": "Alist / OpenList",
            "values": {
              "webdavURL": "http://127.0.0.1:5244/dav/"
            }
          }
        ]
      },
      {
        "id": "webdavUsername",
        "title": "用户名",
        "group": "连接设置",
        "type": "string",
        "placeholder": "账号或邮箱",
        "when": { "field": "provider", "equals": "webdav" }
      },
      {
        "id": "webdavPassword",
        "title": "密码 / 应用密码",
        "description": "坚果云请在网页端生成应用专用密码；保存在本机凭据目录",
        "group": "连接设置",
        "type": "secret",
        "placeholder": "应用密码",
        "when": { "field": "provider", "equals": "webdav" }
      },
      {
        "id": "webdavRoot",
        "title": "远端目录",
        "group": "连接设置",
        "type": "string",
        "default": "ArcMD",
        "placeholder": "ArcMD",
        "when": { "field": "provider", "equals": "webdav" }
      },
      {
        "id": "spaces",
        "title": "选择要同步的空间",
        "description": "每个勾选的空间会同步到远端前缀下各自名称的目录，跳过本地版本历史快照。",
        "group": "同步空间",
        "type": "spaces"
      },
      {
        "id": "autoSync",
        "title": "定时自动同步",
        "description": "每隔一段时间在后台自动双向增量同步。",
        "group": "自动同步",
        "type": "bool",
        "default": false
      },
      {
        "id": "intervalMinutes",
        "title": "同步间隔",
        "group": "自动同步",
        "type": "segmented",
        "default": "15",
        "options": [
          { "value": "5", "label": "5 分钟" },
          { "value": "15", "label": "15 分钟" },
          { "value": "30", "label": "30 分钟" },
          { "value": "60", "label": "60 分钟" }
        ],
        "when": { "field": "autoSync", "equals": true }
      },
      {
        "id": "syncOnSave",
        "title": "保存文档后自动同步",
        "description": "保存已勾选空间的文档 15 秒后自动增量同步。",
        "group": "自动同步",
        "type": "bool",
        "default": true
      },
      {
        "id": "allowInsecureHTTP",
        "title": "允许非加密 HTTP",
        "description": "仅建议在局域网 NAS 上开启；本机 localhost 默认允许。",
        "group": "自动同步",
        "type": "bool",
        "default": false
      }
    ]
  }
}
